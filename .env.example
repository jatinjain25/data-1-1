# Data 1-1 - environment. Copy to .env for local use; on a host, set these in
# its environment settings. Never commit .env.
# `npm run secret` prints a random 64-character value for any *_SECRET / *_KEY / SALT.

# ── required ────────────────────────────────────────────────────────────────
# Postgres 14+. On serverless hosts use the provider's POOLED connection string.
# Local demo with nothing installed: pglite://./.data - ONE process at a time:
# stop the server before running migrate/seed-demo against it (they refuse otherwise).
DATABASE_URL=

# Signs the dashboard's session cookie. 32+ random characters.
SESSION_SECRET=

# Who may open the dashboard: comma-separated Google accounts...
ADMIN_EMAILS=
# ...signing in with this OAuth client id (AGENTS.md step 4). No client secret is needed.
GOOGLE_CLIENT_ID=
# ...or/and a password, for setups without Google. Long and random: `npm run secret`.
ADMIN_PASSWORD=

# Salt for hashing visitor IPs (the bot-burst rule). Raw IPs are never stored.
ANALYTICS_SALT=

# ── recommended ─────────────────────────────────────────────────────────────
# Your server -> POST /api/ingest (accounts, product events, payments).
INGEST_KEY=
# The daily job (ad spend, replays). Vercel Cron sends it automatically.
CRON_SECRET=

# ── revenue module: whichever providers you use ─────────────────────────────
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DODO_WEBHOOK_SECRET=

# ── ads module (Meta) ───────────────────────────────────────────────────────
# A system-user token with ads_read, and the ad account id (act_<digits>).
META_ADS_TOKEN=
META_AD_ACCOUNT=

# ── replays module (Mixpanel Session Replay) ────────────────────────────────
MIXPANEL_SA_USER=
MIXPANEL_SA_SECRET=
MIXPANEL_PROJECT_ID=
MIXPANEL_WORKSPACE_ID=

# ── hosting knobs (optional) ────────────────────────────────────────────────
# The header your site's /ke proxy puts the VISITOR's IP in (AGENTS.md step 6).
# Default x-client-ip; Netlify: x-nf-client-connection-ip.
CLIENT_IP_HEADER=
# How many proxies of YOURS sit in front of the server (0 on Vercel/Cloudflare,
# 1 behind one load balancer). Decides which X-Forwarded-For entry is the visitor.
TRUST_PROXY=0
# Delete raw events older than this many days (>= 30). Unset = keep everything.
RETAIN_DAYS=
# Node server only: port, and whether the platform calls /api/cron itself.
PORT=8787
DISABLE_INTERNAL_CRON=
# Vercel only: let the functions read raw bodies (webhook signatures need them).
NODEJS_HELPERS=0
